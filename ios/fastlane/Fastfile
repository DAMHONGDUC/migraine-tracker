# Fastlane never archives in this project — it signs, exports and distributes
# what `packages/system_design/tool/build-ipa.sh` builds.
#
# Firebase and RevenueCat config arrive through `--dart-define-from-file`, a
# flag xcodebuild and `gym` know nothing about. An archive made by them carries
# empty config: `Firebase.initializeApp` throws, `main()` swallows it, and the
# app dies on the first `FirebaseAuth.instance` with "[core/no-app] No Firebase
# App '[DEFAULT]' has been created" — a crash naming nothing to do with the
# missing flag. That is the same trap as archiving from Xcode, and the reason
# that script exists at all. Do not replace the `sh` call below with
# `build_app`.

require "English"
require "json"
require "tmpdir"
require "shellwords"

default_platform(:ios)

APP_ID = "app.dd.migraine.tracker".freeze
WIDGET_ID = "app.dd.migraine.tracker.BaroEaseWidgetExtension".freeze
TEAM_ID = "WNG5UWNJ6H".freeze

platform :ios do
  desc "Build through packages/system_design/tool/build-ipa.sh and upload to TestFlight. flavor: dev|prod, bump: true|false, notes: a line for What to Test"
  lane :beta do |options|
    flavor = validate_flavor!((options[:flavor] || "prod").to_s)

    bump = options[:bump].to_s != "false"
    # `notes:` locally, RELEASE_NOTES from the workflow — free text with
    # spaces in it cannot survive a lane argument on a shell command line.
    notes = (options[:notes] || ENV["RELEASE_NOTES"]).to_s.strip

    root = repo_root

    # First, before the network and long before the build. `flavor` picks
    # env/<flavor>.json and nothing else; the Firebase project the app really
    # talks to comes from the native files `packages/system_design/tool/prepare-env.sh <flavor>`
    # copied into the tree, and nothing ties the two together. So
    # `prepare-env-dev` followed by `beta flavor:prod` uploads an app that
    # writes into the wrong Firestore — and it RUNS, so nothing downstream
    # ever says a word. This is the last place that can.
    verify_flavor_config(root, flavor)

    key = asc_api_key

    # Resolved BEFORE the build, either way — an iOS build is the expensive
    # half of this lane, and both the bump and the guard are answered by the
    # same question App Store Connect will ask at the end.
    version, build = pubspec_version(root)
    latest = latest_testflight_build_number(
      api_key: key,
      app_identifier: APP_ID,
      version: version,
      initial_build_number: 0,
    )

    if bump
      # The number is written INTO pubspec.yaml and committed back after the
      # upload — never passed as `--build-number`. That flag would ship a build
      # whose version exists nowhere in git, and the repo could no longer say
      # what went out; see docs/rules/COMMANDS.md. Writing the file keeps that
      # property and still spares a human from remembering.
      #
      # Taken from TestFlight rather than from pubspec alone: App Store Connect
      # refuses a build number it has already seen for this version, and it has
      # seen builds from every branch that ever ran this lane.
      build = ([build.to_i, latest.to_i].max + 1).to_s
      set_pubspec_build_number(root, version, build)
      UI.message("Building #{version}+#{build} (TestFlight was at #{latest}).")
    elsif build.to_i <= latest.to_i
      UI.user_error!(
        "pubspec.yaml is at #{version}+#{build}, but TestFlight already has build " \
        "#{latest} for #{version}. Bump `version:` in pubspec.yaml, or run with bump:true.",
      )
    end

    export_plist = nil

    if is_ci
      # A runner cannot sign automatically — that needs an Apple ID logged into
      # Xcode. So the project is flipped to manual signing for this run only,
      # against what match installs. The checkout is discarded afterwards, so
      # the pbxproj edit never reaches git and a developer's machine keeps
      # automatic signing.
      #
      # `runner?`, not `is_ci`: the throwaway keychain is only right where
      # there is no login keychain worth using, and a Mac running this with
      # CI=true has one. See `runner?` for what the extra keychain costs.
      setup_ci if runner?

      match(
        type: "appstore",
        app_identifier: [APP_ID, WIDGET_ID],
        api_key: key,
        # The certificate is created once, by hand, with `fastlane certificates`.
        # CI may never create one: a runner that can mint distribution certs
        # burns through Apple's limit of three, one failed job at a time.
        readonly: true,
        **git_authorization,
      )

      # Before the build, not during it. Xcode enforces the same rule — every
      # entitlement the target claims must be authorized by its profile — but
      # only once the whole target has compiled, so a profile minted before an
      # entitlement was added costs three and a half minutes to say so. It
      # cost exactly that when Sign in with Apple went in.
      verify_profile_entitlements(root, APP_ID => "Runner/Runner.entitlements",
                                        WIDGET_ID => "BaroEaseWidget/BaroEaseWidget.entitlements")

      [["Runner", APP_ID], ["BaroEaseWidgetExtension", WIDGET_ID]].each do |target, bundle_id|
        update_code_signing_settings(
          path: "#{root}/ios/Runner.xcodeproj",
          use_automatic_signing: false,
          team_id: TEAM_ID,
          targets: [target],
          bundle_identifier: bundle_id,
          profile_name: installed_profile_name(bundle_id),
          code_sign_identity: "Apple Distribution",
          build_configurations: ["Release"],
        )
      end

      # `flutter build ipa --export-method` makes Flutter generate the
      # ExportOptions.plist itself, and that generator maps the MAIN bundle id
      # only — its own source calls multi-target apps a TODO. The widget
      # extension would get no profile and `exportArchive` would fail after the
      # full build. So write the plist here with both ids in it; the script
      # drops its `--export-method` when it sees this flag.
      export_plist = write_export_options_plist(
        APP_ID => installed_profile_name(APP_ID),
        WIDGET_ID => installed_profile_name(WIDGET_ID),
      )
    end

    command = ["sh", "packages/system_design/tool/build-ipa.sh", flavor]
    command << "--export-options-plist=#{export_plist}" if export_plist
    Dir.chdir(root) { sh(*command) }

    # build-ipa.sh wipes build/ios/ipa before every build, so this glob
    # matches exactly one file and it is the one just built.
    ipa = Dir["#{root}/build/ios/ipa/*.ipa"].first
    UI.user_error!("No IPA under build/ios/ipa — the build produced nothing.") if ipa.nil?

    # Not waiting for processing: App Store Connect takes 10–20 minutes to
    # finish, a macOS runner bills at ten times a Linux one, and nothing in
    # this lane reads the result. TestFlight emails when the build is ready.
    #
    # A `changelog` softens that flag rather than cancelling it: pilot then
    # waits for the build to APPEAR in App Store Connect — a couple of
    # minutes, not the full processing — writes the note, and skips the rest.
    # Worth those minutes because the note is the only thing on the build
    # that says dev or prod; see `testflight_changelog`.
    note = testflight_changelog(flavor, version, build, notes)

    # BOTH, and neither one alone works.
    #
    # `changelog` is the flag pilot reads to decide whether to wait at all
    # (`build_manager.rb`: `return if config[:changelog].nil?`), so dropping
    # it makes the lane return before the build appears and write nothing.
    #
    # But `changelog` alone writes nothing either. It ends up in
    # `update_localized_build_review(build, {}, default_info: …)`, which
    # builds its list of locales from the localizations the build ALREADY
    # has — and a build fetched the moment it appears has none, because App
    # Store Connect creates them during processing. The loop then iterates an
    # empty list, raises nothing, and pilot still logs "Successfully set the
    # changelog for build". That is the whole bug: every build shipped with
    # an empty "What to Test" and a green lane.
    #
    # `localized_build_info` is checked first and names the locale outright,
    # so the same code path takes its `post_beta_build_localizations` branch
    # and CREATES the localization instead of needing one to exist.
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      app_identifier: APP_ID,
      changelog: note,
      localized_build_info: { "en-US" => { whats_new: note } },
      skip_waiting_for_build_processing: true,
    )

    # Crashlytics cannot symbolicate a crash without the dSYMs, and with bitcode
    # gone nothing on Apple's side uploads them. Best effort on purpose: the
    # build is already on TestFlight by now, and a symbol upload that fails must
    # not take the build-number commit down with it. It says so loudly instead.
    upload_dsyms(root)

    # Pushed AFTER the upload, on purpose. A bump commit for a build that never
    # shipped is only a gap in the numbering; a build on TestFlight whose
    # number is in no commit is the thing this whole rule exists to prevent.
    # If the push fails here the job fails loudly with the build already up —
    # commit the number by hand rather than releasing over it.
    commit_build_number(root, version, build) if bump && is_ci

    UI.success("Uploaded #{flavor} #{version}+#{build} to TestFlight.")
  end

  desc "Upload an IPA that is already in build/ios/ipa, without rebuilding. flavor: dev|prod. For a build that succeeded and an upload that did not."
  lane :upload do |options|
    # The recovery path for `beta` dying after the twenty-five minute build:
    # a network drop, an expired token, a rejected binary. The IPA on disk is
    # the one that was built, so nothing here builds, bumps or signs — doing
    # any of it would produce a DIFFERENT binary and the one on disk would
    # still be unuploaded.
    flavor = validate_flavor!((options[:flavor] || "prod").to_s)
    notes = (options[:notes] || ENV["RELEASE_NOTES"]).to_s.strip

    root = repo_root
    verify_flavor_config(root, flavor)

    ipa = Dir["#{root}/build/ios/ipa/*.ipa"].first
    UI.user_error!("No IPA under build/ios/ipa. Build one first: melos run release-#{flavor}.") if ipa.nil?

    # pubspec is the number the binary carries: `beta` writes it there BEFORE
    # the build, so the file and the IPA agree unless someone edited it in
    # between — which would make the note lie about the build it describes.
    version, build = pubspec_version(root)
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      version: version,
      initial_build_number: 0,
    )
    if build.to_i <= latest.to_i
      UI.user_error!(
        "TestFlight already has build #{latest} for #{version}, and this IPA is #{build}. " \
        "It was uploaded already, or it needs rebuilding with a higher number.",
      )
    end

    note = testflight_changelog(flavor, version, build, notes)
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa,
      app_identifier: APP_ID,
      changelog: note,
      localized_build_info: { "en-US" => { whats_new: note } },
      skip_waiting_for_build_processing: true,
    )

    upload_dsyms(root)

    UI.success("Uploaded #{flavor} #{version}+#{build} to TestFlight.")
  end

  desc "Everything a release depends on except the build. flavor:dev|prod also checks the config in the tree. Rehearse the runner with CI=true."
  lane :preflight do |options|
    # The release lane's first three minutes, without the twenty-five that
    # follow. Every credential failure met so far — a rejected token, a
    # newline inside the auth header, a second empty Authorization header —
    # lands in here, and none of them needs an IPA to surface.
    #
    # Locally this skips match, because a developer's Mac signs automatically
    # and has no reason to touch the shared certificate. `CI=true` turns that
    # branch on and rehearses what the runner will do, in seconds — into the
    # login keychain, since `setup_ci` is gated on `runner?` and a Mac keeps
    # the keychain it already has:
    #
    #   cd ios && CI=true bundle exec fastlane preflight
    #
    # To reproduce the runner's environment exactly, set the same variables it
    # sets — including the ones whose secrets do not exist, which is precisely
    # how the duplicate-header failure happened:
    #
    #   CI=true MATCH_GIT_BEARER_AUTHORIZATION= bundle exec fastlane preflight
    root = repo_root

    # Optional, and skipped rather than defaulted when absent: defaulting to
    # prod would fail a rehearsal on a machine set up for dev, over the one
    # question the rehearsal was not asked.
    flavor = options[:flavor].to_s
    if flavor.empty?
      UI.important("No flavor: given, so the config in the tree was not checked. Pass flavor:dev or flavor:prod for that.")
    else
      verify_flavor_config(root, validate_flavor!(flavor))
    end

    key = asc_api_key

    version, build = pubspec_version(root)
    latest = latest_testflight_build_number(
      api_key: key,
      app_identifier: APP_ID,
      version: version,
      initial_build_number: 0,
    )
    UI.success("App Store Connect answered. pubspec is #{version}+#{build}, TestFlight is at #{latest}.")

    unless is_ci
      UI.important("Not CI, so match was skipped — that is the half most likely to break.")
      UI.important("Rehearse it with: CI=true bundle exec fastlane preflight")
      next
    end

    setup_ci if runner?
    match(
      type: "appstore",
      app_identifier: [APP_ID, WIDGET_ID],
      api_key: key,
      readonly: true,
      **git_authorization,
    )
    UI.success("Profiles installed: #{installed_profile_name(APP_ID)}, #{installed_profile_name(WIDGET_ID)}")

    verify_profile_entitlements(root, APP_ID => "Runner/Runner.entitlements",
                                      WIDGET_ID => "BaroEaseWidget/BaroEaseWidget.entitlements")
    UI.success("Both profiles carry every entitlement their target claims.")
  end

  desc "Create or renew the distribution certificate and both profiles. Local only. force:true regenerates them."
  lane :certificates do |options|
    # CI runs match readonly, so the certificate has to be minted from a real
    # machine once — and renewed from one when it expires.
    UI.user_error!("Run this on your Mac. CI uses readonly: true on purpose.") if is_ci

    # An existing profile is REUSED by default, and that is the trap behind
    # every "profile doesn't include the … entitlement": adding a capability
    # to the App ID does not touch a profile Apple already issued, and match
    # sees one in its repo and installs it unchanged. force:true regenerates
    # both from the App IDs as they stand now and pushes them to the
    # certificates repo, which is the only way CI's readonly match can ever
    # see the new entitlement.
    #
    #   cd ios && bundle exec fastlane certificates force:true
    #
    # It does NOT touch the certificate — only the profiles — so the limit of
    # three distribution certificates is not at risk here.
    force = options[:force].to_s == "true"
    match(type: "appstore", app_identifier: [APP_ID, WIDGET_ID], api_key: asc_api_key, force: force)
  end
end

# True only on an actual GitHub runner, which is a narrower question than
# `is_ci`.
#
# `is_ci` is true on any machine with CI set — including a Mac rehearsing the
# release with `CI=true bundle exec fastlane preflight`, which is exactly what
# the docs tell a developer to run. And `setup_ci` on a Mac creates
# `~/Library/Keychains/fastlane_tmp_keychain-db`, adds it to the keychain
# SEARCH LIST, and never takes it out again: on a runner the whole machine is
# discarded, on a laptop it stays for good. match then imports the shared
# certificate into it, so the same certificate lives in two keychains and
# `security find-identity -v -p codesigning` starts reporting four "Apple
# Distribution" identities where there is one — an identity being a
# (certificate, private key) pair, and the search pairing either copy of the
# cert with either copy of the key. Each of those is one more key codesign can
# stop and ask about at `exportArchive`.
#
# So the throwaway keychain is a runner's answer to having no login keychain
# worth using, and a Mac already has one. Everything else about the rehearsal
# is unchanged: match still runs, still readonly, and installs into the
# keychain that is already there.
def runner?
  !ENV["GITHUB_ACTIONS"].to_s.empty?
end

# Lanes run with the working directory set to `ios/fastlane`, so the repo root
# is two levels up. Checked rather than assumed: every path below is built from
# it, and a wrong root would fail much later with something unrecognisable.
def repo_root
  root = File.expand_path("../..", Dir.pwd)
  UI.user_error!("No pubspec.yaml at #{root} — fastlane is not where it thinks it is.") unless File.exist?("#{root}/pubspec.yaml")
  root
end

# Returns ["1.0.0", "12"] from `version: 1.0.0+12`.
def pubspec_version(root)
  raw = read_pubspec(root)[/^version:\s*(\S+)/, 1]
  UI.user_error!("pubspec.yaml has no `version:` line.") if raw.nil?

  name, build = raw.split("+")
  UI.user_error!("pubspec.yaml version #{raw} carries no +build number.") if build.nil?

  [name, build]
end

# The encoding is stated, never inherited. pubspec.yaml holds em dashes, and
# Ruby with no UTF-8 locale reads it as US-ASCII — then the first regex against
# it dies with "invalid byte sequence in US-ASCII", a failure that names the
# encoding and not the missing LANG. Same trap CocoaPods falls into in
# tool/set-up.sh, and a runner is exactly the stripped environment that has no
# locale set.
def read_pubspec(root)
  File.read("#{root}/pubspec.yaml", encoding: "UTF-8")
end

# How the runner authenticates to the private certificates repo.
#
# GitHub accepts either header form for a personal access token. Bearer takes
# the token verbatim; Basic wants base64 of "user:token", which is one more
# step to get wrong — and getting it wrong fails as `could not read Username
# for 'https://github.com'`, a message about prompts that says nothing about
# the credential being rejected.
#
# The empty ones are DELETED from the environment, not merely left unpassed.
# match reads both env vars itself, whichever option this method returns, so
# picking one here does not stop the other from being used. Actions sets every
# `${{ secrets.X }}` it is handed — empty string included, for a secret that
# does not exist — and an empty one becomes a SECOND `Authorization` header.
# Git sends both, and GitHub answers `Duplicate header: "Authorization"` with a
# 400 that names neither the empty variable nor the workflow that set it.
def git_authorization
  %w[MATCH_GIT_BEARER_AUTHORIZATION MATCH_GIT_BASIC_AUTHORIZATION].each do |name|
    ENV.delete(name) if ENV[name].to_s.empty?
  end

  bearer = ENV["MATCH_GIT_BEARER_AUTHORIZATION"]
  return { git_bearer_authorization: bearer } if bearer

  basic = ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
  return { git_basic_authorization: basic } if basic

  UI.user_error!("Set MATCH_GIT_BEARER_AUTHORIZATION (the PAT as-is) or MATCH_GIT_BASIC_AUTHORIZATION (base64 of user:PAT).")
end

# Sends the archive's dSYMs to Crashlytics, or explains why it could not.
#
# Two of fastlane's defaults do not hold in this project:
#   - the action looks for `Pods/FirebaseCrashlytics/upload-symbols`, and
#     Firebase resolves through Swift Package Manager here, so that path does
#     not exist. The binary ships as a package artifact under DerivedData in a
#     folder whose name carries a build-specific hash — hence searched for,
#     never hardcoded.
#   - `gsp_path` is not available either: ios/Runner/GoogleService-Info.plist
#     is gitignored and absent from a CI checkout. The app id arrives as an env
#     var instead, which also keeps this lane from parsing env/*.json.
#
# Every exit is a warning and a return, never a raise. Missing symbols are
# something to go and fix; they are not a reason to re-cut a build that is
# already on TestFlight.
def upload_dsyms(root)
  app_id = ENV["FIREBASE_APP_ID_IOS"]
  if app_id.nil? || app_id.empty?
    UI.important("FIREBASE_APP_ID_IOS is unset — skipping the Crashlytics symbol upload.")
    return
  end

  dsyms = "#{root}/build/ios/archive/Runner.xcarchive/dSYMs"
  unless Dir.exist?(dsyms)
    UI.important("No dSYMs at #{dsyms} — skipping the Crashlytics symbol upload.")
    return
  end

  binary = Dir.glob(File.expand_path("~/Library/Developer/Xcode/DerivedData/Runner-*/SourcePackages/artifacts/**/upload-symbols")).first
  if binary.nil?
    UI.important("Crashlytics upload-symbols is not under DerivedData — skipping the symbol upload.")
    return
  end

  upload_symbols_to_crashlytics(dsym_path: dsyms, app_id: app_id, binary_path: binary)
rescue StandardError => e
  UI.important("Crashlytics symbol upload failed, the build is still up: #{e.message}")
end

# Rewrites the `version:` line, keeping the name and replacing the +build.
def set_pubspec_build_number(root, version_name, build)
  before = read_pubspec(root)
  after = before.sub(/^version:\s*\S+$/, "version: #{version_name}+#{build}")
  UI.user_error!("Could not rewrite the `version:` line in pubspec.yaml.") if after == before
  File.write("#{root}/pubspec.yaml", after, encoding: "UTF-8")
end

# Commits the bumped pubspec.yaml, and the design system's gitlink, back to the
# branch the workflow ran on.
#
# Two paths and no others: on CI the checkout is also carrying a pbxproj
# switched to manual signing and an env/*.json written from a secret, and
# neither may ever reach a commit.
#
# The gitlink is in there because the workflow follows the design system's
# branch rather than the commit the parent pins. Without recording where that
# branch was, the IPA on TestFlight would contain a system_design commit this
# repo never wrote down — and "what went out" would be unanswerable for half
# the UI, which is the same failure the build-number rule exists to prevent.
#
# `[skip ci]` keeps the push from starting the analyze-and-test workflow over a
# version bump that has already been built and shipped.
def commit_build_number(root, version_name, build)
  branch = ENV["GITHUB_REF_NAME"]
  UI.user_error!("GITHUB_REF_NAME is unset — no branch to push the bump to.") if branch.nil? || branch.empty?

  message = "chore: release - build #{version_name}+#{build} [skip ci]"

  # The design system's commit is named in the message as well as staged in the
  # tree. That is deliberate duplication, and the only kind this repo keeps: a
  # gitlink shows up in neither `git log --oneline` nor a GitHub commit list,
  # so the one place someone actually looks when asking "what shipped in 14?"
  # is the one place the answer was missing. The tree remains the authority;
  # the message is the copy that gets read.
  design = design_system_commit(root)
  message += "\n\nBuilt against system_design #{design}" if design

  Dir.chdir(root) do
    sh("git", "add", "pubspec.yaml", "packages/system_design")
    sh("git", "commit", "-m", message)
    sh("git", "push", "origin", "HEAD:refs/heads/#{branch}")
  end
end

# The build's "What to Test" note in TestFlight: `dev - 1.0.0 (2)`.
#
# One bundle id serves both flavors (see Appfile), so a dev build and a prod
# build sit in the same TestFlight list with only the number between them —
# and a tester who installs the wrong one reports bugs against the wrong
# Firebase project. That is the whole job of this line, so it says the flavor
# and the version and nothing else. `notes` is whoever triggered the run
# asking for something specific to be looked at; it is empty most of the time
# and adds a second line when it is not.
def testflight_changelog(flavor, version, build, notes)
  line = "#{flavor} - #{version} (#{build})"
  notes.empty? ? line : "#{line}\n\n#{notes}"
end

# The design system's HEAD as `<short sha> <subject>`, or nil if the submodule
# is not there to ask — a missing line in a commit message is not worth failing
# a release that has already shipped.
def design_system_commit(root)
  out = `git -C "#{root}/packages/system_design" log -1 --format='%h %s' 2>/dev/null`.strip
  out.empty? ? nil : out
end

# App Store Connect API key, from a file locally and from a secret in CI.
# Base64 on the CI side because the .p8 is multi-line and a secret that loses
# its newlines fails as an unreadable key rather than as a missing one.
def asc_api_key
  common = { key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID") }

  content = ENV["ASC_KEY_CONTENT"]
  if content && !content.empty?
    app_store_connect_api_key(**common, key_content: content, is_key_content_base64: true)
  else
    app_store_connect_api_key(**common, key_filepath: ENV.fetch("ASC_KEY_FILEPATH"))
  end
end

# The profile match just installed for one bundle id. match publishes the
# mapping in the lane context; the sigh env var is the older channel for the
# same thing and covers a match version that stops setting the context.
def installed_profile_name(bundle_id)
  mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
  name = mapping[bundle_id] || mapping[bundle_id.to_sym] || ENV["sigh_#{bundle_id}_appstore_profile-name"]
  UI.user_error!("match installed no App Store profile for #{bundle_id}.") if name.nil?
  name
end

# dev or prod, or the lane stops here. Both lanes ask it, and the answer
# indexes .firebaserc, env/ and env_assets/ alike.
def validate_flavor!(flavor)
  UI.user_error!("flavor must be dev or prod, got #{flavor.inspect}") unless %w[dev prod].include?(flavor)
  flavor
end

# Fails the lane unless the config sitting in the tree belongs to the flavor
# being uploaded.
#
# Everything it reads is either committed or already shipping inside the IPA —
# never env/ (hard rule 13). `.firebaserc` is the authority on which project a
# flavor means because it is the same file `firebase deploy` reads: one place
# to change when a project id does, and no second list to forget.
def verify_flavor_config(root, flavor)
  expected = firebaserc_project(root, flavor)

  gsp = "#{root}/ios/Runner/GoogleService-Info.plist"
  unless File.exist?(gsp)
    UI.user_error!("#{gsp} is missing. Run `sh packages/system_design/tool/prepare-env.sh #{flavor}`, or download it from the Firebase console.")
  end

  project = plist_value(gsp, "PROJECT_ID")
  if project != expected
    UI.user_error!(
      "GoogleService-Info.plist is #{project.inspect}, but flavor #{flavor} means #{expected.inspect} " \
      "(.firebaserc). The tree is set up for the other environment — run " \
      "`sh packages/system_design/tool/prepare-env.sh #{flavor}` and start again.",
    )
  end

  bundle_id = plist_value(gsp, "BUNDLE_ID")
  if bundle_id != APP_ID
    UI.user_error!("GoogleService-Info.plist is registered to #{bundle_id.inspect}, not #{APP_ID} — that is another app's file.")
  end

  verify_sign_in_url_scheme(root, gsp, flavor)
  verify_crashlytics_app_id(gsp)

  UI.success("Config check: #{flavor} is #{expected}, and the tree matches it.")
end

# The project id a flavor stands for, from the file the Firebase CLI already
# uses for the same mapping.
def firebaserc_project(root, flavor)
  path = "#{root}/.firebaserc"
  UI.user_error!("No .firebaserc at #{path} — nothing to check the flavor against.") unless File.exist?(path)

  projects = JSON.parse(File.read(path, encoding: "UTF-8"))["projects"] || {}
  id = projects[flavor].to_s
  UI.user_error!(".firebaserc has no `#{flavor}` alias. It has: #{projects.keys.join(', ')}.") if id.empty?
  id
end

# The Google sign-in callback returns on a URL scheme that is the reversed
# client id of ONE Firebase project, and it lives in Info.plist — a second
# copy of something GoogleService-Info.plist already says. `prepare-env.sh`
# writes both, so they part company only when one of them is stale, and then
# the app builds, installs, opens the Google sheet and never gets the callback
# back. Nothing about that failure names a plist.
#
# Searched as text, not through PlistBuddy: CFBundleURLTypes is an array of
# dicts with no key addressing the right one, and a reversed client id is
# unique enough that its presence anywhere in the file is the whole question.
def verify_sign_in_url_scheme(root, gsp, flavor)
  reversed = plist_value(gsp, "REVERSED_CLIENT_ID").to_s
  if reversed.empty?
    UI.important("GoogleService-Info.plist carries no REVERSED_CLIENT_ID — skipping the sign-in URL scheme check.")
    return
  end

  info_plist = "#{root}/ios/Runner/Info.plist"
  return if File.read(info_plist, encoding: "UTF-8").include?(reversed)

  UI.user_error!(
    "ios/Runner/Info.plist does not carry #{reversed}, the sign-in URL scheme of the " \
    "#{flavor} Firebase project. Google sign-in would build fine and never receive its " \
    "callback. Run `sh packages/system_design/tool/prepare-env.sh #{flavor}`.",
  )
end

# dSYMs go wherever FIREBASE_APP_ID_IOS points, and that one is a CI secret
# rather than something read from the build — so it is the only value here
# that can name the other project while everything in the tree is right. The
# upload then succeeds and puts the symbols where no crash will look for them.
# Unset is fine and stays fine: `upload_dsyms` skips with a warning.
def verify_crashlytics_app_id(gsp)
  configured = ENV["FIREBASE_APP_ID_IOS"].to_s
  return if configured.empty?

  expected = plist_value(gsp, "GOOGLE_APP_ID").to_s
  return if expected.empty? || configured == expected

  UI.user_error!(
    "FIREBASE_APP_ID_IOS is not this project's iOS app id — GoogleService-Info.plist says " \
    "#{expected}. Crashlytics symbols would go to the wrong Firebase app.",
  )
end

# Fails the lane if a target claims an entitlement its installed profile does
# not carry — the check Xcode performs at signing, run before the compile
# instead of after it.
#
# Key presence only, never values. `aps-environment` is "development" in the
# entitlements file and "production" in an App Store profile, on purpose (see
# Runner.entitlements), so comparing values would fail every build. Xcode
# reconciles those; what it cannot reconcile is a key the profile has never
# heard of, and that is the only thing checked here.
#
# The remedy is always the same two steps, and neither is in this repo:
# add the capability to the App ID in the developer portal, then regenerate
# the profiles with `fastlane certificates force:true` from a Mac. CI's match
# is readonly and can only install what is already in the certificates repo.
def verify_profile_entitlements(root, targets)
  targets.each do |bundle_id, entitlements_path|
    claimed = plist_keys("#{root}/ios/#{entitlements_path}")
    granted = profile_entitlement_keys(bundle_id)
    next if granted.nil?

    missing = claimed - granted
    next if missing.empty?

    UI.user_error!(
      "Profile \"#{installed_profile_name(bundle_id)}\" does not carry #{missing.join(', ')}, " \
      "which #{entitlements_path} claims. Enable the capability on App ID #{bundle_id} in the " \
      "developer portal, then run `bundle exec fastlane certificates force:true` on your Mac.",
    )
  end
end

# The entitlement keys of the profile sigh just installed for one bundle id, or
# nil when the profile cannot be found or read. Nil skips the check rather than
# failing it: this guard exists to explain a build that was going to fail
# anyway, and it must never be the reason a good build does not go out.
def profile_entitlement_keys(bundle_id)
  path = ENV["sigh_#{bundle_id}_appstore_profile-path"]
  if path.nil? || !File.exist?(path)
    UI.important("No installed profile file for #{bundle_id} — skipping the entitlement check.")
    return nil
  end

  # A .mobileprovision is a CMS-signed plist; `security cms -D` unwraps it.
  decoded = File.join(Dir.mktmpdir("baroease-profile"), "profile.plist")
  sh("security cms -D -i #{path.shellescape} > #{decoded.shellescape}", log: false)
  plist_keys(decoded, "Entitlements")
rescue StandardError => e
  UI.important("Could not read the profile for #{bundle_id} (#{e.message}) — skipping the entitlement check.")
  nil
end

# The keys of a plist dict, read with PlistBuddy so no gem has to be added for
# it. `scope` names a nested dict; omitted, it reads the root.
def plist_keys(path, scope = nil)
  entry = scope ? ":#{scope}" : ""
  out = sh("/usr/libexec/PlistBuddy -c 'Print #{entry}' #{path.shellescape}", log: false)
  # PlistBuddy prints `Dict { \n    key = value \n ... }`; the keys are the
  # names left of the first `=` at one level of indentation. Nested dicts and
  # arrays indent further, so the depth filter is what keeps their contents out.
  out.lines.map do |line|
    next unless line.start_with?("    ") && !line.start_with?("        ")

    name = line.strip.split(" = ", 2).first
    name unless name.nil? || name.empty? || name == "}"
  end.compact
end

# One value out of a plist, or nil when the key is not there. Same PlistBuddy
# reasoning as `plist_keys`: no gem to add for it.
#
# Backticks rather than `sh`, because the config check reads four keys before
# every build and each `sh` prints its own step banner whether or not it is
# asked to log — a dozen lines of noise in front of a lane whose real failures
# come at the end.
def plist_value(path, key)
  out = `/usr/libexec/PlistBuddy -c #{"Print :#{key}".shellescape} #{path.shellescape} 2>/dev/null`
  $CHILD_STATUS.success? ? out.strip : nil
end

# One ExportOptions.plist covering every target. `provisioningProfiles` takes
# profile names, and every bundle id in the archive must appear or the export
# fails on the one that is missing.
def write_export_options_plist(profiles)
  entries = profiles.map do |bundle_id, profile|
    "            <key>#{bundle_id}</key>\n            <string>#{profile}</string>"
  end.join("\n")

  path = File.join(Dir.mktmpdir("baroease-export"), "ExportOptions.plist")
  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
        <key>method</key>
        <string>app-store</string>
        <key>teamID</key>
        <string>#{TEAM_ID}</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>provisioningProfiles</key>
        <dict>
    #{entries}
        </dict>
        <key>uploadBitcode</key>
        <false/>
        <key>stripSwiftSymbols</key>
        <true/>
    </dict>
    </plist>
  PLIST

  path
end
