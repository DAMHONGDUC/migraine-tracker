# What BaroEase is. Nothing else.
#
# Every lane — `beta`, `upload`, `preflight`, `certificates` — lives in the
# design system and is shared with every other app embedding it. This file
# hands it the facts that cannot be shared: the team, the targets, their bundle
# ids and the entitlements each one claims.
#
# The import comes FIRST: it is what defines `sd_ios_app`.
#
# To override one lane for this app, define a lane of the same name below the
# import — fastlane prefers the one in the file it was pointed at.
import "../../packages/system_design/tool/fastlane/Fastfile"

sd_ios_app(
  team_id: "WNG5UWNJ6H",
  # Ordered: the first target IS the app, and its bundle id is what every
  # upload, config check and TestFlight query uses. The rest are extensions —
  # they need a profile and an export entry, and are never uploaded alone.
  #
  # One bundle id serves both dev and prod, so both land in the SAME TestFlight
  # app and the note the lane composes is the only thing telling them apart.
  targets: [
    {
      name: "Runner",
      bundle_id: "app.dd.migraine.tracker",
      entitlements: "Runner/Runner.entitlements",
    },
    {
      name: "BaroEaseWidgetExtension",
      bundle_id: "app.dd.migraine.tracker.BaroEaseWidgetExtension",
      entitlements: "BaroEaseWidget/BaroEaseWidget.entitlements",
    },
  ],
)
