<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Answers App Store Connect's export-compliance question at upload time
	     instead of asking on every build. False = the app uses only exempt
	     encryption.

	     That is accurate today: the one cryptographic call in the app is a
	     SHA-256 of the Sign in with Apple nonce, which is a hash used for
	     authentication, and everything else rides HTTPS through the OS.
	     Both are exempt.

	     REVISIT when the encrypted attack sync in hard rule 1 actually
	     ships. Standard algorithms are still exempt, but the answer stops
	     being obvious and may need a self-classification report. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Migraine Tracker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- The languages the App Store lists for this app, and the set iOS
	     resolves the device locale against. A Flutter app ships its
	     translations in ARB files rather than .lproj folders, so without this
	     key the store advertises English alone. Keep it in step with the
	     app_*.arb files. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>vi</string>
		<string>ja</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleName</key>
	<string>migraine_tracker</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.235085850446-gc8vdt1gmdjd82knu7j768lb9nd4rovt</string>
			</array>
		</dict>
		<dict>
			<!-- The home screen widget's own link. WidgetKit routes a widget URL
			     to its containing app without this, but registering it is what
			     makes the path testable (`xcrun simctl openurl`) and what a
			     future deep link would use. The only thing it can do is open the
			     log flow. -->
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.dd.migraine.tracker.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>baroease</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSHealthShareUsageDescription</key>
	<string>BaroEase reads your sleep, step count and — only if you switch it on — your menstrual cycle from Apple Health, to show whether short nights, low activity or the days around your period line up with your migraine attacks. It only reads. Your sleep and your cycle stay on this device and are never uploaded. When you log an attack, the steps you had taken that day are saved with it, so they travel with that attack into your export and, if you sign in, your encrypted sync.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>BaroEase never writes anything to Apple Health. It only reads your sleep, steps and, if you switch it on, your menstrual cycle, to show what lines up with your migraine attacks.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>BaroEase uses your approximate location to attach local barometric pressure to your attack logs and power pressure-drop alerts. Your location never leaves your device beyond a ~5km area code.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
