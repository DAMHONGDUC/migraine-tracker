<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one thing the extension needs: the container the app writes the
	     widget's strings into. Must match the app's own entitlement and
	     HomeWidgetConstant.appGroupId. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.dd.migraine.tracker</string>
	</array>
</dict>
</plist>
