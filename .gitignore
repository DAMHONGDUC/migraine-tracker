# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Firebase config (non-secret client IDs, but kept out of git; all
# regenerated by `flutterfire configure`). dart-define JSON + native files.
env/*.json
# ...except the key-only templates `melos run setup` copies into place.
!env/*.example.json
ios/Runner/GoogleService-Info.plist
android/app/google-services.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/
# Generated localizations
lib/l10n/gen/
# Written by `melos bootstrap` to point path dependencies at the local
# checkout. Machine state, regenerated on every bootstrap.
pubspec_overrides.yaml
