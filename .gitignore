# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Firebase config (non-secret client IDs, but kept out of git; all
# regenerated by `flutterfire configure`). dart-define JSON + native files.
env/*.json
# ...except the key-only templates `melos run setup` copies into place.
!env/*.example.json
ios/Runner/GoogleService-Info.plist
android/app/google-services.json

# The unpacked originals of all of the above, per environment, that
# `melos run prepare-env-dev|prod` copies into place. Same live keys as
# env/, so it stays out of git for the same reason.
env_assets/

# The Cloud Functions dotenv the Firebase CLI reads at deploy. Its contents are
# identifiers rather than secrets — the WeatherKit `.p8` is in Secret Manager —
# but it is per-developer, so only the template is tracked.
functions/.env
!functions/.env.example

# Fastlane. `report.xml`/`Preview.html` are per-run output, and the `.p8` and
# any `.env` next to the Fastfile carry the App Store Connect key — a secret on
# the same footing as env/, and the reason it is named here rather than trusted
# to stay out by habit.
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/screenshots/
ios/fastlane/test_output/
ios/fastlane/.env*
ios/fastlane/*.p8

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/
# Generated localizations
lib/l10n/gen/
# Written by `melos bootstrap` to point path dependencies at the local
# checkout. Machine state, regenerated on every bootstrap.
pubspec_overrides.yaml
