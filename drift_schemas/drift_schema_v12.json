  "fixed_sql": [
    {
      "name": "attacks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attacks\" (\"id\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"intensity\" INTEGER NOT NULL, \"location\" TEXT NOT NULL, \"medication_name\" TEXT NULL, \"symptoms\" TEXT NOT NULL DEFAULT '[]', \"triggers\" TEXT NOT NULL DEFAULT '[]', \"notes\" TEXT NULL, \"exertion_level\" TEXT NULL, \"medication_effect\" TEXT NULL, \"ended_at\" INTEGER NULL, \"updated_at\" INTEGER NULL, \"revision\" INTEGER NOT NULL DEFAULT 0, \"synced_revision\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "weather_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weather_snapshots\" (\"attack_id\" TEXT NOT NULL REFERENCES attacks (id) ON DELETE CASCADE, \"captured_at\" INTEGER NOT NULL, \"pressure_hpa\" REAL NOT NULL, \"pressure_delta24h_hpa\" REAL NOT NULL, \"humidity_percent\" REAL NULL, \"temperature_celsius\" REAL NULL, PRIMARY KEY (\"attack_id\"));"
        }
      ]
    },
    {
      "name": "medications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medications\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NULL, \"updated_at\" INTEGER NULL, \"revision\" INTEGER NOT NULL DEFAULT 0, \"synced_revision\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "medication_reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medication_reminders\" (\"id\" TEXT NOT NULL, \"medication_id\" TEXT NOT NULL REFERENCES medications (id) ON DELETE CASCADE, \"minute_of_day\" INTEGER NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"created_at\" INTEGER NULL, \"updated_at\" INTEGER NULL, \"revision\" INTEGER NOT NULL DEFAULT 0, \"synced_revision\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_notifications",
      "sql": [
