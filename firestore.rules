rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ownership for the synced collections, which are shared between users —
    // `userId` is the whole boundary, so this is the one place it is checked.
    //
    // Two functions, not one combining them, and the reason is queries. A
    // query has no single document to test, so Firestore proves it safe from
    // the query's own filters. That proof only works when the read condition
    // is a plain constraint on a field: fold in a disjunction — say
    // `resource == null || ...` to cover creates — and there is a branch that
    // constrains nothing, the proof fails, and EVERY query is denied. That
    // exact mistake shipped once and looked identical to un-deployed rules.
    function ownsStored() {
      return request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // The incoming document. Checked on write so a user cannot set `userId`
    // to someone else's — planting a record in their account, or handing
    // over one of their own. Testing only the stored value would miss it.
    function ownsIncoming() {
      return request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    function isSynced(collection) {
      return collection in ['attacks', 'medications', 'medication_reminders',
                            'notifications'];
    }

    // Release metadata the app reads on every launch to decide whether the
    // installed build is still allowed (see FirestoreAppUpdateRepository).
    // World-readable on purpose: the check runs before any sign-in, and the
    // record holds nothing but store links and build numbers. Records are
    // published from the console/CI (Admin SDK bypasses rules), so clients
    // can never write one — a forged record would lock users out.
    match /app_updates/{recordId} {
      allow read: if true;
      allow write: if false;
    }

    // The per-user key that attack payloads are encrypted with. Denied to
    // every client, including its owner: it is handed out only by the
    // getSyncKey callable, which checks the caller is signed in (never
    // anonymous) and reaches Firestore through the Admin SDK, which bypasses
    // rules. Deny-by-default here means a leaked client can read keys for
    // nobody, not even itself.
    match /sync_keys/{uid} {
      allow read, write: if false;
    }

    // Each user may only touch their own settings doc. Hard rule 1: this
    // doc holds ONLY geohash5, fcmToken, alertThreshold, tz, premium and —
    // for signed-in users — the account fields displayName, email, photoUrl,
    // createdAt, updatedAt. Never health data: that lives on-device and, when
    // synced, encrypted in the collections below. premium is written
    // exclusively by the RevenueCat webhook (Admin SDK bypasses rules), so
    // clients must not set it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource == null ? {} : resource.data)
            .affectedKeys()
            .hasAny(['premium']);
    }

    // Encrypted record sync for signed-in users. Every document here is
    // ciphertext plus its timestamp and owner — see EncryptedRecordMapper.
    //
    // The list is an allowlist, not a bare `{collection}`, and must be kept in
    // step with the `SyncCollection` enum. At the root a bare wildcard would
    // be far worse than it was under users/: it would match `sync_keys` and
    // `app_updates` too, and any collection added later.
    // `sync_collection_rules_test.dart` fails the build when the enum and this
    // list drift apart — which is how medications and reminders once shipped
    // denied, breaking sync AND the dev seed on their first query.
    //
    // Note what these rules can NOT do: a query over one of these collections
    // has no single document to evaluate, so Firestore refuses it unless the
    // client filters by userId itself. `OwnedCollection` is what guarantees
    // that on this side; nothing here can.
    match /{collection}/{docId} {
      allow read: if isSynced(collection) && ownsStored();
      allow create: if isSynced(collection) && ownsIncoming();
      allow update: if isSynced(collection) && ownsStored() && ownsIncoming();
      allow delete: if isSynced(collection) && ownsStored();
    }
  }
}
