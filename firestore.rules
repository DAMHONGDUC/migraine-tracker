rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ownership for the synced collections, which are shared between users —
    // `userId` is the whole boundary, so this is the one place it is checked.
    //
    // Two functions, not one combining them, and the reason is queries. A
    // query has no single document to test, so Firestore proves it safe from
    // the query's own filters. That proof only works when the read condition
    // is a plain constraint on a field: fold in a disjunction — say
    // `resource == null || ...` to cover creates — and there is a branch that
    // constrains nothing, the proof fails, and EVERY query is denied. That
    // exact mistake shipped once and looked identical to un-deployed rules.
    function ownsStored() {
      return request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // The incoming document. Checked on write so a user cannot set `userId`
    // to someone else's — planting a record in their account, or handing
    // over one of their own. Testing only the stored value would miss it.
    function ownsIncoming() {
      return request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    function isSynced(collection) {
      return collection in ['attacks', 'medications', 'medication_reminders',
                            'daily_logs', 'midas', 'notifications'];
    }

    // Everything that applies to every install at once: `enable_premium` (the
    // app-wide premium kill switch) and `force_update` (the published build
    // per platform, read on every launch by FirestoreAppUpdateRepository — it
    // replaced the `app_updates` collection, so a release is announced by
    // editing the one document the owner already edits).
    //
    // One fixed document id, `app`, which no sign-in can produce as an
    // address, so it can never collide with an allow-list row below.
    //
    // World-readable on purpose, and it is what decides the split: the update
    // check runs before any sign-in, the app is fully usable anonymously, and
    // this document holds nothing but booleans, build numbers and store
    // links. **No email ever goes on it** — a per-address grant lives in its
    // own row below precisely because rules cannot hide a field, and an array
    // of addresses here would be the owner's list of real people, readable by
    // anyone who installs the app.
    //
    // Written only from the console. A client that could flip these is a
    // client deciding its own premium state, and a forged force-update record
    // would lock users out.
    match /app_config/app {
      allow read: if true;
      allow write: if false;
    }

    // The owner's allow-list: one document per address, id = the address
    // lower-cased. `premium` grants premium in the app and makes the account a
    // target of the pressure-alert cron; `dev_settings` shows the Dev group in
    // Settings; `blocked` locks the address out of the app. Replaces the
    // PREMIUM_EMAIL / SHOW_DEV_SETTINGS build flags, which could only be
    // changed by shipping a new binary.
    //
    // A client may read ONE document — its own — and never list the
    // collection. That is the whole reason the address is the document id
    // rather than a field: a collection matched on a field has to be readable
    // as a whole to be readable at all, and the whole is a list of real
    // people's email addresses. The cron reads it through the Admin SDK,
    // which bypasses rules.
    //
    // The block above grants the one non-address document its own read; this
    // rule denying that id changes nothing, because rules are OR-ed. What
    // neither block allows is a LIST: a query has no single document to
    // evaluate, so `app_config` as a whole stays unreadable.
    //
    // Written only from the console. A client that could grant itself premium
    // is exactly the client-side premium flag this project forbids.
    match /app_config/{email} {
      allow read: if request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // One document per pressureAlertJob run — see functions/src/index.ts.
    // Operational history for the owner, written by the Admin SDK and read
    // from the console. No client has any business with it, and it names uids
    // and geohash cells, so it is denied outright rather than left to the
    // allow-list below.
    match /pressure_alert_runs/{runId} {
      allow read, write: if false;
    }

    // The per-user key that attack payloads are encrypted with. Denied to
    // every client, including its owner: it is handed out only by the
    // getSyncKey callable, which checks the caller is signed in (never
    // anonymous) and reaches Firestore through the Admin SDK, which bypasses
    // rules. Deny-by-default here means a leaked client can read keys for
    // nobody, not even itself.
    match /sync_keys/{uid} {
      allow read, write: if false;
    }

    // Each user may only touch their own settings doc. Hard rule 1: this
    // doc holds ONLY geohash5, fcmToken, alertThreshold, tz, tzOffsetMinutes,
    // premium and — for signed-in users — the account fields displayName,
    // email, photoUrl, createdAt, updatedAt. Never health data: that lives
    // on-device and, when synced, encrypted in the collections below. premium
    // is written exclusively by the RevenueCat webhook (Admin SDK bypasses
    // rules), so clients must not set it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource == null ? {} : resource.data)
            .affectedKeys()
            .hasAny(['premium']);
    }

    // Encrypted record sync for signed-in users. Every document here is
    // ciphertext plus its timestamp and owner — see EncryptedRecordMapper.
    //
    // The list is an allowlist, not a bare `{collection}`, and must be kept in
    // step with the `SyncCollection` enum. At the root a bare wildcard would
    // be far worse than it was under users/: it would match `sync_keys` and
    // `app_config` too, and any collection added later.
    // `sync_collection_rules_test.dart` fails the build when the enum and this
    // list drift apart — which is how medications and reminders once shipped
    // denied, breaking sync AND the dev seed on their first query.
    //
    // `weather_cache`, `app_config` and `pressure_alert_runs` rely on this
    // being an allowlist: each is written only by the Admin SDK and must stay
    // unreachable from a client here, so all three are deliberately absent
    // rather than overlooked. (`app_config` grants a one-document read of its
    // own above; this wildcard must not widen that to a query.)
    //
    // Note what these rules can NOT do: a query over one of these collections
    // has no single document to evaluate, so Firestore refuses it unless the
    // client filters by userId itself. `OwnedCollection` is what guarantees
    // that on this side; nothing here can.
    match /{collection}/{docId} {
      allow read: if isSynced(collection) && ownsStored();
      allow create: if isSynced(collection) && ownsIncoming();
      allow update: if isSynced(collection) && ownsStored() && ownsIncoming();
      allow delete: if isSynced(collection) && ownsStored();
    }
  }
}
